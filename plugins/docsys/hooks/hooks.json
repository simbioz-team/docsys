{
  "description": "docsys — реестры документации всегда собраны",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/on-doc-edit.sh\"",
            "timeout": 60,
            "statusMessage": "Пересборка реестров документации..."
          }
        ]
      }
    ]
  }
}
